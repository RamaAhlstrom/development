{
    "OnActivityBackPressed": "/SAPAssetManager/Rules/WorkOrders/CreateUpdate/CancelCheckOnBackNavAndroid.js",
    "_Type": "Page",
    "_Name": "FLFetchOnlineDocuments",
    "ActionBar":
    {
        "Items":
        [{
            "_Type": "Fragment",
            "Fragment": "/SAPAssetManager/Pages/Fragments/CancelButton.fragment",
            "Properties": {
                "OnPress": "/SAPAssetManager/Actions/Page/ClosePage.action"
            }
        },   
        {
            "Position": "Right",
            "Text": "$(L,download)",
            "OnPress": "/SAPAssetManager/Rules/FL/Fetch/FLSetDownloadDocumentsVariable.js"
        }]
    },
    "Caption":"$(L,fetch_results)",
    "Controls":
    [{
        "Sections":
        [{
            "Visible": "/SAPAssetManager/Rules/FL/Fetch/VoyageListViewSectionIsVisible.js",
            "Header":
            {
                "UseTopPadding": false
            },
            "EmptySection":
            {
                "Caption": "$(L,no_documents_found_on_online_search)"
            },
            "Selection":
            {
                "Mode": "Multiple",
                "ExitOnLastDeselect": false
            },
            "OnSelectionChanged": "/SAPAssetManager/Rules/FL/Fetch/FLOnDocumentSelectedOrUnSelected.js",
            "ObjectCell": {
                "_Type": "Fragment",
                "Fragment":  "/SAPAssetManager/Pages/Fragments/FL/VoyageCell.fragment",
                "Properties": {
                    "StatusText": "/SAPAssetManager/Rules/FL/Voyages/VoyageStatusText.js",
                    "AccessoryType": null,
                    "OnPress": null
                }
            },
            "Target":
            {
                "EntitySet": "FldLogsVoyages",
                "Service": "/SAPAssetManager/Services/OnlineAssetManager.service",
                "QueryOptions": "/SAPAssetManager/Rules/FL/Fetch/VoyageFetchQueryOptions.js"
            },
            "_Type": "Section.Type.ObjectTable",
            "_Name" : "VoyageListViewSection"
        },
        {
            "Visible": "/SAPAssetManager/Rules/FL/Fetch/ContainerListViewSectionIsVisible.js",
            "Header":
            {
                "UseTopPadding": false
            },
            "EmptySection":
            {
                "Caption": "$(L,no_documents_found_on_online_search)"
            },
            "Selection":
            {
                "Mode": "Multiple",
                "ExitOnLastDeselect": false
            },
            "OnSelectionChanged": "/SAPAssetManager/Rules/FL/Fetch/FLOnDocumentSelectedOrUnSelected.js",
            "ObjectCell": {
                "_Type": "Fragment",
                "Fragment":  "/SAPAssetManager/Pages/Fragments/FL/ContainerCell.fragment",
                "Properties": {
                    "StatusText": "/SAPAssetManager/Rules/FL/Containers/ListView/ContainerStatusText.js",
                    "OnPress": null,
                    "AccessoryType": null
                }
            },
            "Target":
            {
                "EntitySet": "FldLogsContainers",
                "Service": "/SAPAssetManager/Services/OnlineAssetManager.service",
                "QueryOptions": "/SAPAssetManager/Rules/FL/Fetch/ContainerOrPackageFetchQueryOptions.js"
            },
            "_Type": "Section.Type.ObjectTable",
            "_Name" : "ContainerListViewSection"
        },
        {
            "Visible": "/SAPAssetManager/Rules/FL/Fetch/PackageListViewSectionIsVisible.js",
            "Header":
            {
                "UseTopPadding": false
            },
            "EmptySection":
            {
                "Caption": "$(L,no_documents_found_on_online_search)"
            },
            "Selection":
            {
                "Mode": "Multiple",
                "ExitOnLastDeselect": false
            },
            "OnSelectionChanged": "/SAPAssetManager/Rules/FL/Fetch/FLOnDocumentSelectedOrUnSelected.js",
            "ObjectCell": {
                "_Type": "Fragment",
                "Fragment":  "/SAPAssetManager/Pages/Fragments/FL/PackageCell.fragment",
                "Properties": {
                    "StatusText": "/SAPAssetManager/Rules/FL/Containers/ListView/ContainerStatusText.js",
                    "OnPress": null,
                    "AccessoryType": null
                }
            },
            "Target":
            {
                "EntitySet": "FldLogsPackages",
                "Service": "/SAPAssetManager/Services/OnlineAssetManager.service",
                "QueryOptions": "/SAPAssetManager/Rules/FL/Fetch/ContainerOrPackageFetchQueryOptions.js"
            },
            "_Type": "Section.Type.ObjectTable",
            "_Name" : "PackageListViewSection"
        },
        {
            "Visible": "/SAPAssetManager/Rules/FL/Fetch/HUDelItemsListViewSectionIsVisible.js",
            "Header":
            {
                "UseTopPadding": false
            },
            "EmptySection":
            {
                "Caption": "$(L,no_documents_found_on_online_search)"
            },
            "Selection":
            {
                "Mode": "Multiple",
                "ExitOnLastDeselect": false
            },
            "OnSelectionChanged": "/SAPAssetManager/Rules/FL/Fetch/FLOnDocumentSelectedOrUnSelected.js",
            "ObjectCell": {
                "_Type": "Fragment",
                "Fragment":  "/SAPAssetManager/Pages/Fragments/FL/HUDelItemsCell.fragment",
                "Properties": {
                    "StatusText": "/SAPAssetManager/Rules/FL/HUDelItems/ListView/HUDelItemsStatusText.js",
                    "OnPress": null,
                    "AccessoryType": null
                }
            },
            "Target":
            {
                "EntitySet": "FldLogsHuDelItems",
                "Service": "/SAPAssetManager/Services/OnlineAssetManager.service",
                "QueryOptions": "/SAPAssetManager/Rules/FL/Fetch/HUDelItemsFetchQueryOptions.js"
            },
            "_Type": "Section.Type.ObjectTable",
            "_Name" : "HUDelItemsListViewSection"
        }],
            "_Type": "Control.Type.SectionedTable",
            "_Name" : "SectionedTable"
        }
    ]
}