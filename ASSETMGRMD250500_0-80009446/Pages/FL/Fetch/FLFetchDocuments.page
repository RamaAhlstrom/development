{
    "OnActivityBackPressed": "/SAPAssetManager/Rules/WorkOrders/CreateUpdate/CancelCheckOnBackNavAndroid.js",
    "ActionBar": {
        "Items": [
            {
                "_Type": "Fragment",
                "Fragment": "/SAPAssetManager/Pages/Fragments/CancelButton.fragment",
                "Properties": {                  
                    "OnPress": "/SAPAssetManager/Actions/Page/ClosePage.action"
                }
            },
            {
                "Position": "Right",
                "Text": "$(L,fetch)",
                "OnPress": "/SAPAssetManager/Rules/FL/Search/FLFetchDocumentsWithActivityIndicator.js"
            }
        ]
    },
    "Caption":"$(L,fetch_documents)",
    "Controls": [
        {
            "Sections": [
                {
					"_Name": "FetchDefaultSection",
					"_Type": "Section.Type.FormCell",
                    "Controls": [
                        {
                            "AllowEmptySelection": false,
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection": true,
                            "Caption": "$(L,document_type_label)",
                            "PickerItems": "/SAPAssetManager/Rules/FL/Fetch/FLDocumentTypes.js",
                            "Value": "/SAPAssetManager/Rules/FL/Fetch/FLDefaultDocumentTypes.js",
							"OnValueChange": "/SAPAssetManager/Rules/FL/Fetch/FLDocumentTypesOnValueChanged.js",
                            "_Name": "DocumentTypeListPicker",
                            "_Type": "Control.Type.FormCell.ListPicker"
                        },
                        {
                            "_Name": "PlantListPicker",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,to_plant)",
                            "AllowMultipleSelection": false,
                            "AllowDefaultValueIfOneItem": true,
                            "IsPickerDismissedOnSelection" : true,
                            "IsSearchCancelledAfterSelection": true,
                            "AllowEmptySelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "Value": "/SAPAssetManager/Rules/FL/Fetch/FLSetDefaultPlant.js",
                            "PickerItems": {
                                "DisplayValue": "{{#Property:Plant}} - {{#Property:PlantName}}",
                                "ReturnValue": "{Plant}",
                                "Target": {
                                    "EntitySet": "FldLogsPlants",
                                    "Service": "/SAPAssetManager/Services/AssetManager.service",
                                    "QueryOptions": "$orderby=Plant"
                                }
                            }
                        }
                    ]
                },
                {
					"_Name": "FetchVoyagesSection",
					"_Type": "Section.Type.FormCell",
                    "Controls": [
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "VoyageNumber",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,fl_voyage_number)"
                        },
                        {
                            "_Name": "VoyageStatus",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,fl_voyage_status)",
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection": true,
                            "IsSearchCancelledAfterSelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "PickerItems": "/SAPAssetManager/Rules/FL/Fetch/VoyageStatusPickerItems.js"
                        },
                        {
                            "_Name": "ModeOfTransport",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,fl_mode_of_transport)",
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection": true,
                            "IsSearchCancelledAfterSelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "PickerItems": {
                                "DisplayValue": "{{#Property:Description}}",
                                "ReturnValue": "{VoyageTypeCode}",
                                "Target": {
                                    "EntitySet": "FldLogsVoyageTypeCodes",
                                    "Service": "/SAPAssetManager/Services/AssetManager.service",
                                    "QueryOptions": "$orderby=Description"
                                }
                            }
                        },
                        {
                            "_Type": "Control.Type.FormCell.Switch",
                            "_Name": "PADateSwitch",
                            "Caption":"$(L,planned_arrival_date)",
                            "Value": false,
                            "OnValueChange": "/SAPAssetManager/Rules/FL/Voyages/VoyagePADateFilter.js"
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "StartDateFilter",
                            "Caption": "$(L,date_from)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "EndDateFilter",
                            "Caption": "$(L,date_to)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ReceivingPoint",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,receiving_point)"
                        },
                        {
                            "_Name": "FromPlant",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,from_plant)",
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection" : true,
                            "IsSearchCancelledAfterSelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "PickerItems": {
                                "DisplayValue": "{{#Property:Plant}} - {{#Property:PlantName}}",
                                "ReturnValue": "{Plant}",
                                "Target": {
                                    "EntitySet": "FldLogsPlants",
                                    "Service": "/SAPAssetManager/Services/AssetManager.service",
                                    "QueryOptions": "$orderby=Plant"
                                }
                            }
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ShippingPoint",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,fl_shipping_point)"
                        }
                    ]
                },
                {
					"_Name": "FetchContainersSection",
					"_Type": "Section.Type.FormCell",
                    "Visible": false,
                    "Controls": [
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerID",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,container_id)"
                        },
                        {
                            "_Name": "ContainerStatus",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,container_status)",
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection": true,
                            "IsSearchCancelledAfterSelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "PickerItems": "/SAPAssetManager/Rules/FL/Containers/ListView/ContainerStatusPickerItems.js"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerWorkOrdMaintOrd",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,work_ord_maint_ord)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerProduct",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,product)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerWBSElementProject",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,wbs_element_project)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "KitID",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,kit_id)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerVoyageNumber",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,fl_voyage_number)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.Switch",
                            "_Name": "ContainerDispatchDateSwitch",
                            "Caption":"$(L,dispatch_date)",
                            "Value": false,
                            "OnValueChange": "/SAPAssetManager/Rules/FL/Containers/ListView/ContainerDispatchDateFilter.js"
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "ContainerStartDateFilter",
                            "Caption": "$(L,date_from)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "ContainerEndDateFilter",
                            "Caption": "$(L,date_to)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ContainerReceivingPoint",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,receiving_point)"
                        }
                    ]
                },
                {
					"_Name": "FetchHUDelItemsSection",
					"_Type": "Section.Type.FormCell",
                    "Visible": false,
                    "Controls": [
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HandlingUnit",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,handling_unit)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "ReferenceDocNumber",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,reference_doc_number)"
                        },
                        {
                            "_Name": "HUDelItemsStatus",
                            "_Type": "Control.Type.FormCell.ListPicker",
                            "Caption": "$(L,fld_delivery_item_status)",
                            "AllowMultipleSelection": false,
                            "IsPickerDismissedOnSelection": true,
                            "IsSearchCancelledAfterSelection": true,
                            "Search": {
                                "Enabled": true,
                                "Delay": 500,
                                "MinimumCharacterThreshold": 3,
                                "Placeholder": "$(L,search)",
                                "BarcodeScanner": true
                            },
                            "PickerItems": "/SAPAssetManager/Rules/FL/HUDelItems/ListView/HUDelItemsStatusPickerItems.js"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsWorkOrdMaintOrd",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,work_ord_maint_ord)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsProduct",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,product)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsWBSElementProject",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,wbs_element_project)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsKitID",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,kit_id)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsVoyageNumber",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,fl_voyage_number)"
                        },
                        {
                            "_Type": "Control.Type.FormCell.Switch",
                            "_Name": "HUDelItemsDispatchDateSwitch",
                            "Caption":"$(L,dispatch_date)",
                            "Value": false,
                            "OnValueChange": "/SAPAssetManager/Rules/FL/HUDelItems/ListView/HUDelItemsDispatchDateFilter.js"
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "HUDelItemsStartDateFilter",
                            "Caption": "$(L,date_from)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.DatePicker",
                            "_Name": "HUDelItemsEndDateFilter",
                            "Caption": "$(L,date_to)",
                            "Mode": "Date",
                            "IsVisible": false
                        },
                        {
                            "_Type": "Control.Type.FormCell.SimpleProperty",
                            "_Name": "HUDelItemsReceivingPoint",
                            "AlternateInput": "Barcode",
                            "Caption":"$(L,receiving_point)"
                        }
                    ]
                },
                {
					"_Name": "FetchResetSection",
					"_Type": "Section.Type.FormCell",
                    "Controls": [
                        {
                            "TextAlignment": "/SAPAssetManager/Rules/Common/Platform/ModalButtonAlign.js",
                            "ButtonType": "Text",
                            "Semantic": "Tint",
                            "Title": "$(L,reset)",
                            "_Name": "FormCellButton0",
                            "_Type": "Control.Type.FormCell.Button",
                            "OnPress": "/SAPAssetManager/Rules/FL/Fetch/FLFetchDocumentsResetFields.js",
                            "Styles": {
                                "Button": "FetchResetButton"
                            }
                        }
                    ]
                }
            ],
            "_Name": "SectionedTable",
            "_Type": "Control.Type.SectionedTable"
        }
    ],
    "_Type":"Page",
	"_Name":"FLFetchDocuments"
}