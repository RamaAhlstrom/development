{
	"Caption": "$(L,app_display_name)",
	"ActionBar": {
		"Items": [
			{
				"Position": "Right",
				"Icon":"$(PLT,sap-icon://download, sap-icon://download,'', sap-icon://download)",
				"OnPress": "/SAPAssetManager/Actions/EWM/Fetch/FetchDocuments.action",
				"Visible": "/SAPAssetManager/Rules/Common/IsDemoModeDisabled.js"
			},
			"/SAPAssetManager/Pages/Fragments/SyncButton.fragment"
		]
	},
	"Controls": [
		{
			"_Type": "Control.Type.SectionedTable",
			"_Name" : "SectionedTable",
			"Sections": [
						{
					"ObjectCells":[
						{
						"ObjectCell":{ 
                            "PreserveIconStackSpacing": false,
                            "Title": "/SAPAssetManager/Rules/EWM/Resource/GetWarehouseWithLabel.js",
                            "Subhead": "/SAPAssetManager/Rules/EWM/Resource/GetResourceText.js",
						    "OnPress": "/SAPAssetManager/Actions/EWM/OverviewPage/ResourceListViewNav.action",
						     "Styles": {
                                "Subhead": "ObjectCellStyleBlue"
                            }
                        }		
						}
					],
					"Header": {
						"Caption": "",
						"UseTopPadding": false
					},
				    "Search": {
                        "Enabled": true,
                        "Delay": 500,
                        "MinimumCharacterThreshold": 3,
                        "Placeholder": "$(L,search)",
                        "BarcodeScanner": true
                    },
					"MaxItemCount": 2,

					"DataSubscriptions": [
                        "WarehouseOrders"
                    ],
					"_Name": "EWMHeaderSection",
                    "_Type": "Section.Type.ObjectTable"
				},
				{
					"Header": {
						"Caption": "$(L,ewm_warehouse_orders)",
						"UseTopPadding": true
					},
					"EmptySection": {
						"Caption": "$(L,ewm_no_warehouse_orders)"
					},
				    "Search": {
                        "Enabled": true,
                        "Delay": 500,
                        "MinimumCharacterThreshold": 3,
                        "Placeholder": "$(L,search)",
                        "BarcodeScanner": true
                    },
					"MaxItemCount": 2,
					"ObjectCell": "/SAPAssetManager/Pages/Fragments/EWM/WarehouseOrderCell.fragment",
					"Target": {
						"EntitySet": "WarehouseOrders",
						"QueryOptions":"/SAPAssetManager/Rules/EWM/WarehouseOrder/WarehouseOrderListQueryOptions.js",
						"Service": "/SAPAssetManager/Services/AssetManager.service"
					},
					"Footer": {
						"Caption": "$(L,see_all)",
						"AccessoryType": "DisclosureIndicator",
						"AttributeLabel": "/SAPAssetManager/Rules/EWM/OverviewPage/OverviewAttributeLabel.js",
						"FooterStyle": "Attribute",
						"OnPress": "/SAPAssetManager/Rules/EWM/WarehouseOrder/WOListDetailsQuery.js",
						"Visible": true
					},
					"DataSubscriptions": [
                        "WarehouseOrders"
                    ],
					"_Name": "EWMWarehouseOrderSection",
                    "_Type": "Section.Type.ObjectTable"
				},
				{
					"Header": {
						"Caption": "$(L,ewm_warehouse_tasks)",
						"UseTopPadding": true
					},
					"EmptySection": {
						"Caption": "$(L,ewm_no_tasks)"
					},
					"Search": {
                        "Enabled": true,
                        "Delay": 500,
                        "MinimumCharacterThreshold": 3,
                        "Placeholder": "$(L,search)",
                        "BarcodeScanner": true
                    },
					"MaxItemCount": 2,
					"ObjectCell": "/SAPAssetManager/Pages/Fragments/EWM/WarehouseTaskCell.fragment",
					"Target": {
						"EntitySet": "WarehouseTasks",
						"QueryOptions":"/SAPAssetManager/Rules/EWM/WarehouseTask/ListView/WarehouseTaskListQuery.js",
						"Service": "/SAPAssetManager/Services/AssetManager.service"
					},
					"Footer": {
						"Caption": "$(L,see_all)",
						"AccessoryType": "DisclosureIndicator",
						"AttributeLabel": "/SAPAssetManager/Rules/EWM/OverviewPage/OverviewAttributeLabel.js",
						"FooterStyle": "Attribute",
						"OnPress": "/SAPAssetManager/Rules/EWM/WarehouseTask/WTListDetailsQuery.js",
						"Visible": true
					},
					"DataSubscriptions": [
                        "WarehouseTasks"
                    ],
					"_Name": "EWMWarehouseTaskSection",
                    "_Type": "Section.Type.ObjectTable"
				},
				{
					"Header": {
						"Caption": "$(L,physical_inventory_label)",
						"UseTopPadding": true
					},
					"EmptySection": {
						"Caption": "$(L,no_items)"
					},
					"Search": {
                        "Enabled": true,
                        "Delay": 500,
                        "MinimumCharacterThreshold": 3,
                        "Placeholder": "$(L,search)",
                        "BarcodeScanner": true
                    },
					"MaxItemCount": 2,
					"ObjectCell": "/SAPAssetManager/Pages/Fragments/EWM/PhysicalInventoryCell.fragment",
					"Target": {
                        "EntitySet": "WarehousePhysicalInventoryItems",
                        "Service": "/SAPAssetManager/Services/AssetManager.service",
                        "QueryOptions": "/SAPAssetManager/Rules/EWM/PhysicalInventory/WHPhysicalInvListQuery.js"
                            },
					"Footer": {
						"Caption": "$(L,see_all)",
						"AccessoryType": "DisclosureIndicator",
						"AttributeLabel": "/SAPAssetManager/Rules/EWM/OverviewPage/OverviewAttributeLabel.js",
						"OnPress": "/SAPAssetManager/Rules/EWM/PhysicalInventory/WHPhyInvListDetailsQuery.js",
						"FooterStyle": "Attribute",
						"Visible": true
					},
					"DataSubscriptions": [
						"WarehousePhysicalInventoryItems"
					],
					"_Name": "EWMWarehousePhysicalInventorySection",
          			"_Type": "Section.Type.ObjectTable"
				}
			]
		}
	],
	"_Type": "Page",
	"_Name": "EWMOverviewPage",
  	"OnReturning": "/SAPAssetManager/Rules/EWM/OverviewPage/RefreshOverviewPage.js",
	"OnLoaded": "/SAPAssetManager/Rules/EWM/OverviewPage/EWMOverviewPageOnLoaded.js",
	"OnResume": "/SAPAssetManager/Rules/EWM/OverviewPage/EWMOverviewPageOnResume.js",
	"DataSubscriptions": ["/SAPAssetManager/Services/AssetManager.service", "UserPreferences"]
}
